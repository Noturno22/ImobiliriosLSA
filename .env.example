# ---------------------------------------------------------------------------
# Serrote Imobiliária — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Production/staging: managed PostgreSQL connection string (requires SSL).
#   postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Local development fallback uses embedded PostgreSQL (PGlite) via
#   packages/database when DATABASE_URL is set to the sentinel `pglite`.
DATABASE_URL="pglite://.data/serrote"

# PGlite data directory (local dev only)
PGLITE_DIR=".data/serrote"

# --- Auth (Auth.js / NextAuth v5) -----------------------------------------
# Generate with: openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
AUTH_URL="http://localhost:3000"

# Initial administrator, provisioned on the first PGlite initialisation.
# Change these before any real deployment; leave blank to skip provisioning.
ADMIN_EMAIL="admin@serrote.local"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador Serrote"

# --- Public site ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp click-to-chat number in international format, digits only.
# Company number verified for Serrote Imobiliária.
NEXT_PUBLIC_WHATSAPP_NUMBER="+244926717730"

# Public YouTube channel URL (e.g. https://www.youtube.com/@serroteimobiliaria).
# Leave empty to hide the subscribe action and show a neutral placeholder.
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=""

# --- WhatsApp notifications (CallMeBot) -----------------------------------
# Automatic lead notifications sent server-side. The company number must first
# message the CallMeBot WhatsApp bot once to activate its API key:
#   https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_PHONE is the company number in international digits (no +).
CALLMEBOT_PHONE="244926717730"
CALLMEBOT_APIKEY=""

# --- Optional: object storage / media (not yet configured) ----------------
# MEDIA_STORAGE_DRIVER="local"      # local | s3
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
