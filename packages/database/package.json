{
  "name": "@serrote/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:pglite:ddl": "node scripts/gen-pglite-ddl.mjs",
    "db:pglite:init": "node --env-file=../../apps/web/.env.local --import tsx scripts/pglite-init.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "pglite-prisma-adapter": "^0.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  }
}
